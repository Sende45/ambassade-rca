generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
}

enum StatutRendezVous {
  EN_ATTENTE
  CONFIRME
  ANNULE
}

model Utilisateur {
  id         String   @id @default(cuid())
  nom        String
  email      String   @unique
  motDePasse String
  role       Role     @default(ADMIN)
  creeLe     DateTime @default(now())
}

model Actualite {
  id              String   @id @default(cuid())
  titre           String
  slug            String   @unique
  extrait         String?
  contenu         String
  categorie       String
  image           String?
  datePublication DateTime @default(now())
  publie          Boolean  @default(false)
  creeLe          DateTime @default(now())
  modifieLe       DateTime @updatedAt
}

model MessageContact {
  id      String   @id @default(cuid())
  nom     String
  email   String
  sujet   String?
  message String
  lu      Boolean  @default(false)
  creeLe  DateTime @default(now())
}

model RendezVous {
  id            String           @id @default(cuid())
  nom           String
  prenom        String
  email         String
  telephone     String
  typeService   String
  dateSouhaitee String
  creneau       String
  message       String?
  statut        StatutRendezVous @default(EN_ATTENTE)
  creeLe        DateTime         @default(now())
}

model Membre {
  id      String   @id @default(cuid())
  nom     String
  prenom  String
  poste   String
  service String?
  photo   String?
  email   String?
  ordre   Int      @default(0)
  creeLe  DateTime @default(now())
}